{
	"info": {
		"_postman_id": "library-api-collection",
		"name": "Library API",
		"description": "Postman collection for testing Library Management API.\n\n## Features\n- Books CRUD operations\n- Authors CRUD operations\n- Search endpoints\n- Transactional operations\n\n## Setup\n1. Start PostgreSQL: `docker-compose up -d`\n2. Run Spring Boot: `./mvnw spring-boot:run`\n3. Import this collection into Postman",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "bookId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "authorId",
			"value": "1",
			"type": "string"
		}
	],
