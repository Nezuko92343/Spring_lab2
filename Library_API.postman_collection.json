		{
			"name": "Transactions",
			"description": "Transactional operations demonstrating ACID properties",
			"item": [
				{
					"name": "Create Author with Books (Success)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"author\": {\n        \"name\": \"J.K. Rowling\",\n        \"country\": \"UK\",\n        \"birthYear\": 1965\n    },\n    \"books\": [\n        {\n            \"title\": \"Harry Potter and the Philosopher's Stone\",\n            \"keywords\": \"fantasy, magic, children\",\n            \"imagePath\": \"/img/hp1.jpg\",\n            \"rating\": \"6+\",\n            \"publicationYear\": 1997,\n            \"isbn\": \"978-0-7475-3269-9\"\n        },\n        {\n            \"title\": \"Harry Potter and the Chamber of Secrets\",\n            \"keywords\": \"fantasy, magic, children\",\n            \"imagePath\": \"/img/hp2.jpg\",\n            \"rating\": \"6+\",\n            \"publicationYear\": 1998,\n            \"isbn\": \"978-0-7475-3849-3\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/authors/with-books",
							"host": ["{{baseUrl}}"],
							"path": ["api", "authors", "with-books"]
						},
						"description": "Creates an author along with their books in a single transaction.\n\n**Expected Result:** Author and all books are created successfully.\n\nThis demonstrates a successful transactional operation where all operations complete."
					},
					"response": []
				},
				{
					"name": "Create Author with Books (Rollback - Duplicate ISBN)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"author\": {\n        \"name\": \"Test Author for Rollback\",\n        \"country\": \"Test Country\",\n        \"birthYear\": 2000\n    },\n    \"books\": [\n        {\n            \"title\": \"First Test Book\",\n            \"keywords\": \"test\",\n            \"rating\": \"0+\",\n            \"publicationYear\": 2024,\n            \"isbn\": \"978-0-TEST-0001-1\"\n        },\n        {\n            \"title\": \"Second Book with Duplicate ISBN\",\n            \"keywords\": \"test, duplicate\",\n            \"rating\": \"0+\",\n            \"publicationYear\": 2024,\n            \"isbn\": \"978-1-4516-2728-2\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/authors/with-books",
							"host": ["{{baseUrl}}"],
							"path": ["api", "authors", "with-books"]
						},
						"description": "Attempts to create an author with books, but the second book has a duplicate ISBN.\n\n**Expected Result:** Transaction ROLLS BACK - neither the author nor any books are created.\n\n**To verify rollback:**\n1. Run this request (should return 400 error)\n2. Check GET /api/authors - \"Test Author for Rollback\" should NOT exist\n3. This demonstrates ACID properties - atomicity ensures all-or-nothing"
					},
					"response": []
				},
				{
					"name": "Create Author with Books (Rollback - Duplicate Author)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"author\": {\n        \"name\": \"Stephen King\",\n        \"country\": \"USA\",\n        \"birthYear\": 1947\n    },\n    \"books\": [\n        {\n            \"title\": \"New Book\",\n            \"keywords\": \"test\",\n            \"rating\": \"16+\",\n            \"publicationYear\": 2024,\n            \"isbn\": \"978-0-NEW-0001-1\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/authors/with-books",
							"host": ["{{baseUrl}}"],
							"path": ["api", "authors", "with-books"]
						},
						"description": "Attempts to create an author that already exists.\n\n**Expected Result:** Error - author with this name already exists."
					},
					"response": []
				},
				{
					"name": "Transfer Books Between Authors (Success)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/authors/1/transfer-books/2",
							"host": ["{{baseUrl}}"],
							"path": ["api", "authors", "1", "transfer-books", "2"]
						},
						"description": "Transfers all books from author ID 1 (Stephen King) to author ID 2 (Unn Frazer).\n\n**Expected Result:** All books are transferred in a single transaction.\n\n**To verify:**\n1. First check GET /api/books/search/author/1 - should have books\n2. Run this transfer request\n3. Check GET /api/books/search/author/1 - should be empty\n4. Check GET /api/books/search/author/2 - should have the transferred books"
					},
					"response": []
				},
				{
					"name": "Transfer Books (Source Author Not Found)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/authors/999/transfer-books/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "authors", "999", "transfer-books", "1"]
						},
						"description": "Attempts to transfer books from a non-existent author.\n\n**Expected Result:** 404 Not Found - Source author not found"
					},
					"response": []
				},
				{
					"name": "Transfer Books (Target Author Not Found)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/authors/1/transfer-books/999",
							"host": ["{{baseUrl}}"],
							"path": ["api", "authors", "1", "transfer-books", "999"]
						},
						"description": "Attempts to transfer books to a non-existent author.\n\n**Expected Result:** 404 Not Found - Target author not found"
					},
					"response": []
				}
			]
